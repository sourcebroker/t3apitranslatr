{
  "name": "sourcebroker/t3apitranslatr",
  "license": [
    "GPL-2.0-or-later"
  ],
  "type": "typo3-cms-extension",
  "description": "Bridge between ext:t3api and ext:translatr which allows to get language labels as JSON.",
  "authors": [
    {
      "name": "SourceBroker Team",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4 || ^14.3",
    "sourcebroker/t3api": "^4.0 || ^5.0",
    "sourcebroker/translatr": "^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "saschaegerer/phpstan-typo3": "^2.2 || ^3.1",
    "ssch/typo3-rector": "^3.16",
    "typo3/coding-standards": "^0.9.0"
  },
  "autoload": {
    "psr-4": {
      "SourceBroker\\T3apitranslatr\\": "Classes"
    }
  },
  "replace": {
    "typo3-ter/t3apitranslatr": "self.version"
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "t3apitranslatr",
      "web-dir": ".Build/Web"
    }
  },
  "scripts": {
    "ci:php:stan": ".Build/bin/phpstan analyse --no-progress",
    "ci:php:cs-fixer": ".Build/bin/php-cs-fixer fix --dry-run --diff",
    "ci:php:rector": ".Build/bin/rector process --dry-run",
    "fix:php:cs-fixer": ".Build/bin/php-cs-fixer fix",
    "fix:php:rector": ".Build/bin/rector process"
  }
}
